# Copy to .env (never commit .env). Keys come from the Volcengine console.

# 豆包语音 (Doubao Speech) API key — new console: 豆包语音 > API Key.
# Activate 录音文件识别2.0 (volc.seedasr.auc) and 语音合成2.0 (seed-tts-2.0) in 开通管理
VOLC_SPEECH_API_KEY=

# 火山方舟 (Ark) API key, for the Doubao language model
ARK_API_KEY=
# Model ID or endpoint ID from the Ark console
DOUBAO_MODEL=doubao-seed-1-6-flash-250828

# Robo's voice (a Doubao TTS 2.0 voice). Override per language with TTS_VOICE_<CODE>, e.g. TTS_VOICE_DE=...
TTS_VOICE=zh_female_vv_uranus_bigtts
